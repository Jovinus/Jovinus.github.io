{% for group in site.data.featured_papers %}
  <h3 class="fp-theme">
    <a href="{{ group.url | relative_url }}">{{ group.theme }}</a>
  </h3>
  <ol class="featured-papers">
    {% for paper in group.papers %}
      <li class="featured-paper{% if paper.highlight %} featured-paper-highlight{% endif %}">
        <div class="fp-title">
          <a href="https://doi.org/{{ paper.doi }}">{{ paper.title }}</a>
        </div>
        <div class="fp-meta">
          <em>{{ paper.journal }}</em>, {{ paper.year }}
          <span class="fp-role">{{ paper.role }}</span>
          <span class="fp-links">
            <a href="https://doi.org/{{ paper.doi }}">DOI</a>
            {%- if paper.code %}
              &middot; <a href="{{ paper.code }}">Code</a>
            {%- endif %}
          </span>
        </div>
        {% if paper.summary %}
          <p class="fp-summary">{{ paper.summary }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
{% endfor %}
